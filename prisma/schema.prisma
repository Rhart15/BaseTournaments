// BASE Events - core data model
// Covers: tournament listings, team registration + payment, and
// pool-play-into-bracket scheduling with live score entry.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sport {
  BASEBALL
  SOFTBALL
}

enum RegistrationStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

enum GameStage {
  POOL
  BRACKET
}

enum GameStatus {
  SCHEDULED
  IN_PROGRESS
  FINAL
  CANCELLED
}

model Tournament {
  id          String   @id @default(cuid())
  name        String
  sport       Sport
  startDate   DateTime
  endDate     DateTime
  venueId     String?
  venue       Venue?   @relation(fields: [venueId], references: [id])
  city        String
  state       String   @default("AR")
  description String?
  entryFeeCents Int
  teamCap     Int
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  divisions     Division[]
  registrations Registration[]
}

model Venue {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  state       String   @default("AR")
  fieldCount  Int      @default(1)
  tournaments Tournament[]
}

model Division {
  id           String   @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  label        String
  ageLimit     Int?

  pools         Pool[]
  registrations Registration[]
  games         Game[]
}

model Pool {
  id         String   @id @default(cuid())
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id])
  label      String

  teams Registration[] @relation("PoolAssignment")
  games Game[]
}

model Registration {
  id           String   @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  divisionId   String
  division     Division @relation(fields: [divisionId], references: [id])
  poolId       String?
  pool         Pool?    @relation("PoolAssignment", fields: [poolId], references: [id])

  teamName     String
  coachName    String
  coachEmail   String
  coachPhone   String

  status        RegistrationStatus @default(PENDING)
  stripeSessionId String?
  paidAt        DateTime?

  seed          Int?
  poolWins      Int       @default(0)
  poolLosses    Int       @default(0)
  runsFor       Int       @default(0)
  runsAgainst   Int       @default(0)

  createdAt     DateTime  @default(now())

  homeGames Game[] @relation("HomeTeam")
  awayGames Game[] @relation("AwayTeam")
  rosterPlayers RosterPlayer[]
}

model RosterPlayer {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String
  jerseyNumber String?
  position     String?

  createdAt    DateTime @default(now())
}

model Game {
  id           String   @id @default(cuid())
  divisionId   String
  division     Division @relation(fields: [divisionId], references: [id])
  poolId       String?
  pool         Pool?    @relation(fields: [poolId], references: [id])

  stage        GameStage
  round        String?
  bracketSlot  Int?

  homeTeamId   String?
  homeTeam     Registration? @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId   String?
  awayTeam     Registration? @relation("AwayTeam", fields: [awayTeamId], references: [id])

  fieldName    String?
  startTime    DateTime?

  homeScore    Int?
  awayScore    Int?
  status       GameStatus @default(SCHEDULED)

  advancesToGameId String?

  updatedAt    DateTime @updatedAt
}

// --- Director / sanctioning-body layer -------------------------------

model Director {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String?
  region        String
  bio           String?
  photoUrl      String?
  sanctionFeePaid Boolean @default(false)
  backgroundCheckStatus ComplianceStatus @default(PENDING)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  teams         Team[]
}

enum ComplianceStatus {
  PENDING
  SUBMITTED
  APPROVED
  EXPIRED
}

// --- Persistent team / roster layer -----------------------------------

model Team {
  id            String   @id @default(cuid())
  name          String
  organization  String?
  directorId    String?
  director      Director? @relation(fields: [directorId], references: [id])
  ageGroup      String
  homeCity      String?
  homeState     String   @default("AR")

  insuranceStatus ComplianceStatus @default(PENDING)
  insuranceProvider String?
  insuranceExpiresAt DateTime?

  createdAt     DateTime @default(now())

  players       Player[]
}

model Player {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id])
  firstName    String
  lastName     String
  jerseyNumber String?
  position     String?
  birthYear    Int?

  backgroundCheckStatus ComplianceStatus @default(PENDING)

  createdAt    DateTime @default(now())
}

// --- Content / marketing layer -----------------------------------------

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  body        String
  coverImageUrl String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
}

model AgeChartEntry {
  id        String @id @default(cuid())
  division  String
  birthYearStart Int
  birthYearEnd   Int
  sport     Sport
  sortOrder Int    @default(0)
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}