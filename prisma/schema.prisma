// BASE Events - core data model
// Covers: tournament listings, team registration + payment, and
// pool-play-into-bracket scheduling with live score entry.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sport {
  BASEBALL
  SOFTBALL
}

enum EventType {
  TOURNAMENT
  LEAGUE
}

enum EntryType {
  TEAM
  INDIVIDUAL
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

enum EventRegistrationStatus {
  OPEN
  CLOSED
  WAITLIST
}

enum DepositType {
  PERCENT
  FLAT
}

// Ordered lists of these (Tournament.poolTiebreakerOrder /
// seedingTiebreakerOrder) drive seedFromPoolStandings() in
// src/lib/brackets.ts -- array order is the priority order, first match wins.
enum TiebreakerRule {
  HEAD_TO_HEAD
  RUN_DIFFERENTIAL
  RUNS_ALLOWED
  RUNS_SCORED
  FEWEST_LOSSES
  FORFEIT_RECORD
  STRENGTH_OF_SCHEDULE
  COIN_FLIP
}

enum RegistrationStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
  // A team past a division's capacity when Division.waitlistEnabled is on.
  // Not created by checkout yet (see DivisionsManager / admin invite panel) --
  // today this is only reachable via an admin manually setting it.
  WAITLISTED
}

enum DivisionFormat {
  POOL_PLAY // no engine support yet -- see generate-bracket route/brackets.ts
  BRACKET
  BOTH
}

enum GameStage {
  POOL
  BRACKET
}

enum GameStatus {
  SCHEDULED
  IN_PROGRESS
  FINAL
  CANCELLED
}

model Tournament {
  id                   String    @id @default(cuid())
  name                 String
  sport                Sport
  startDate            DateTime
  endDate              DateTime
  venueId              String?
  venue                Venue?    @relation(fields: [venueId], references: [id])
  city                 String
  state                String    @default("AR")
  description          String?
  flyerUrl             String?
  entryFeeCents        Int
  teamCap              Int
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // The admin who runs this event. Registration payments route to this
  // admin's connected Stripe account (see User.stripeConnectAccountId),
  // minus the flat platform fee. Set automatically to the creating admin;
  // only a lead admin (User.isSuperAdmin) can reassign it. Nullable only
  // so the column can be added ahead of the one-time backfill -- every
  // real tournament has an owner.
  ownerId String?
  owner   User?   @relation("TournamentOwner", fields: [ownerId], references: [id])

  // --- Event wizard: Details --------------------------------------
  season              String? // e.g. "Fall 2026"
  eventType           EventType               @default(TOURNAMENT)
  entryType           EntryType               @default(TEAM)
  // DRAFT is the correct default going forward; the 23 tournaments that
  // predate this column are one-time-backfilled to PUBLISHED right after
  // this migration lands (see scripts/backfill-event-wizard-fields.mjs),
  // not via a schema default, so new events still start as drafts.
  status              EventStatus             @default(DRAFT)
  featured            Boolean                 @default(false)
  dailyStartTime      String? // "HH:mm", local to the event
  dailyEndTime        String?
  registrationStatus  EventRegistrationStatus @default(OPEN)
  address             String? // street address; city/state above already cover the rest
  displayLocation     String? // public override, e.g. "Downtown Sports Complex"
  slug                String?                 @unique // auto-generated from name+location+date, editable
  logoUrl             String?
  showFlyerInsteadOfLogo Boolean              @default(false)
  staffTags           String[]                @default([])

  // --- Event wizard: Content ---------------------------------------
  // `description` above is the rich-text description/rules field (already
  // rendered publicly); this is the wizard's second, separate content field.
  additionalContent String?

  // --- Event wizard: Options -----------------------------------------

  // Roster rules
  rosterMin                Int? // not currently exposed in the Options UI
  rosterMax                Int?
  guestPlayerLimit         Int? // "max guest players"
  guestPlayerLimitHigherLevel Int? // "max higher-level guest players"
  freezeRoster             Boolean   @default(false)
  acceptRostersAfterStart  Boolean   @default(false)
  rosterDeadlineAt         DateTime?

  // Checkout / payments
  disableCheckPayLater  Boolean       @default(false)
  disableECheck         Boolean       @default(false)
  disableCreditCard     Boolean       @default(false)
  disableProcessingFee  Boolean       @default(false) // stored only -- no fee is applied anywhere in checkout yet
  addToCartText         String?
  depositType           DepositType?
  depositAmount         Int? // PERCENT: whole-number percent. FLAT: cents.
  // No Sales Tax settings table exists anywhere in the app -- this is a
  // per-event override with no platform default to fall back to yet, and
  // isn't applied in checkout math. See item #6 (processing fees/sales tax)
  // in the original admin-hierarchy plan for the eventual global settings.
  salesTaxOverridePercent Float?
  // Lead-admin-only field (enforced in the API route, not just the UI --
  // see src/lib/adminAuth.ts guardLeadAdmin). "Protected" is derived from
  // this being set, not a separate boolean that could drift out of sync.
  eventPasswordHash     String?
  showEventForms        Boolean       @default(true)

  // Display / teams & players -- event-wide switches, independent of the
  // per-division visibility toggles on Division (those scope one division;
  // these scope the whole event). No precedence between the two is wired
  // up yet -- that's for whatever renders the public pages to decide.
  showTeamsAttending             Boolean @default(true)
  showWaitlistedTeams            Boolean @default(true)
  showTeamAssignedInPlayerDashboard Boolean @default(true)
  showTeamsAttendingRosters      Boolean @default(true)
  showFinalResults               Boolean @default(true)
  disableRosterNotifications     Boolean @default(false)
  hideTeamsAttendingLocation     Boolean @default(false)
  hideVenues                     Boolean @default(false)
  hideRules                      Boolean @default(false)
  showRosterOnTeamSchedule       Boolean @default(true)
  showRosterCountOnTeamsAttending Boolean @default(true)
  teamsAttendingDescription      String?

  // Bullet points & labels -- cosmetic text shown on the public event page.
  // Flat columns: exactly one set of these per event, not a repeatable list.
  gameGuaranteeText        String? // e.g. "3gg"
  awardsText               String? // e.g. "1-3"
  batType                  String?
  fieldType                String?
  genderLabel              String? // Coed/Boys/Girls/Open -- display only
  divisionLabelOverride    String?
  costLabelOverride        String?
  specialPriceLabelOverride String?
  stayToPlay               Boolean @default(false)

  // Products & tickets -- settings only, not a product/ticket catalog
  // (no repeatable line items yet; that'd be a separate future feature).
  productsEnabled           Boolean @default(false)
  productsSalesTaxPercent   Float?
  ticketsEnabled            Boolean @default(false)
  ticketsSalesTaxPercent    Float?
  // A link out to a third-party ticket seller, separate from the built-in
  // tickets-with-sales-tax toggle above.
  ticketsExternalLinkEnabled Boolean @default(false)
  ticketsExternalUrl        String?
  ticketsButtonBgColor      String?
  ticketsButtonTextColor    String?

  // Schedule requests
  scheduleRequestEnabledAtCheckout  Boolean @default(false)
  scheduleRequestEnabledInDashboard Boolean @default(false)
  scheduleRequestMaxPerTeam         Int?
  scheduleRequestInstructions       String?

  // --- Event wizard: Schedule ------------------------------------------
  // None of this section is consumed by the actual scheduling engine yet
  // (PoolScheduleSetup.tsx, brackets.ts) or by pricing.ts -- stored for the
  // wizard UI only until that logic gets built. Flagged in EventScheduleForm.
  hideSchedule                Boolean  @default(false)
  scheduleIntervalMinutes     Int      @default(30) // 15 / 30 / 45 / 60
  maxGamesPerDay              Int? // event-wide cap, distinct from payPerGameMaxPerDay below
  coachSelfSchedulingEnabled  Boolean  @default(false)
  coachSelfScoringEnabled     Boolean  @default(false)
  poolToPoolEvent             Boolean  @default(false)
  scheduleNotesWhenShown      String? // shown while hideSchedule=false
  scheduleNotesWhenHidden     String? // shown while hideSchedule=true
  payPerGameEnabled           Boolean  @default(false)
  payPerGameIncludedGames     Int?
  payPerGameMaxPerDay         Int? // cap on games/day counted toward pay-per-game billing
  payPerGamePriceCents        Int?
  // Distinct from scheduleRequestEnabledInDashboard above -- that's a
  // request to change the schedule; this is a request to buy/play an
  // additional game beyond the included pay-per-game allotment.
  payPerGameRequestEnabledInDashboard Boolean @default(false)
  paidPracticeEnabled         Boolean  @default(false)
  paidPracticeMaxSessions     Int?
  paidPracticeDurationMinutes Int?
  paidPracticePriceCents      Int?

  // --- Event wizard: Tie Breakers ---------------------------------------
  // Ordered priority lists consumed by seedFromPoolStandings() in
  // src/lib/brackets.ts -- first rule that isn't a tie wins.
  pointsPerEvent         Int?
  pointsPerGamePlayed    Int?
  poolTiebreakerOrder    TiebreakerRule[] @default([])
  seedingTiebreakerOrder TiebreakerRule[] @default([])

  // --- Event wizard: Alerts ---------------------------------------------
  // Each alert is a button label + the rich content shown when it's
  // expanded/clicked -- not yet rendered anywhere on the public pages.
  weatherAlertButtonLabel String? // e.g. "Weather Updates"
  weatherAlertContent     String? // shown when the button above is expanded
  eventAlertButtonLabel   String? // e.g. "Event Alert"
  eventAlertMessage       String? // more urgent banner-style message

  divisions     Division[]
  registrations Registration[]
  customButtons EventCustomButton[]
  tournamentVenues TournamentVenue[]
}

// --- Schedule wizard step: repeatable custom-button list ----------------
model EventCustomButton {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  text      String
  url       String
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
}

// --- Divisions wizard step: reusable master lists ----------------------
// Picked from when building a Division row on an event; kept separate from
// Division itself so the same age-group/skill-level names are reusable
// across events instead of re-typed per tournament.

model DivisionOption {
  id        String  @id @default(cuid())
  label     String  @unique // "6U", "8U", "10U", "12U", "Open", ...
  sport     Sport? // null = applies to both sports
  sortOrder Int     @default(0)
  active    Boolean @default(true) // retire without deleting rows that reference it

  divisions Division[]
}

model SubdivisionOption {
  id        String  @id @default(cuid())
  label     String  @unique // "Open", "A", "AA", "AAA", "Major", "Rec", ...
  sport     Sport?
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  divisions Division[]
}

model Venue {
  id          String       @id @default(cuid())
  name        String
  address     String
  city        String
  state       String       @default("AR")
  fieldCount  Int          @default(1)
  // Legacy single-venue link (still drives the public map/address display
  // on the tournament page) -- untouched by the Schedule step.
  tournaments Tournament[]
  // Venues actually used for schedule generation -- a tournament can use
  // more than one. Falls back to the legacy single relation above when
  // empty (see src/lib/scheduleGenerator.ts).
  tournamentVenues TournamentVenue[]
  games            Game[]
}

// Join table: which venues a tournament's schedule can use. Separate from
// Tournament.venueId (kept as-is for the existing map/address display)
// since that's a single optional FK and can't represent a multi-venue
// event on its own.
model TournamentVenue {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  venueId      String
  venue        Venue      @relation(fields: [venueId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([tournamentId, venueId])
}

model Division {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  label        String // e.g. "10U", "12U Gold"
  ageLimit     Int?
  teamCap      Int? // optional per-division cap; null means uncapped

  pools            Pool[]
  registrations    Registration[]
  games            Game[]
  resultsFinalized Boolean        @default(false)
  bracketPublished Boolean        @default(false)

  // Set before bracket generation -- usePoolPlay=false skips the pool
  // stage entirely and seeds straight from registration order.
  // gameGuarantee (3 or 4) labels the format; the backside/loser-bracket
  // mechanics that actually enforce it are a separate, not-yet-built
  // feature (see /lib/brackets.ts).
  usePoolPlay   Boolean @default(true)
  gameGuarantee Int     @default(3)

  // --- Event wizard: Divisions row fields -------------------------------
  // Picked from the reusable master lists; label/publicLabelOverride stay
  // the source of truth for display everywhere else in the app, so
  // existing readers of Division.label don't need to change.
  divisionOptionId    String?
  divisionOption      DivisionOption?    @relation(fields: [divisionOptionId], references: [id])
  subdivisionOptionId String?
  subdivisionOption   SubdivisionOption? @relation(fields: [subdivisionOptionId], references: [id])

  publicLabelOverride    String?
  priceCents             Int? // overrides Tournament.entryFeeCents when set
  gameTimeLimitMinutes   Int?
  breakMinutes           Int?
  // BRACKET/BOTH map onto usePoolPlay above and drive real bracket
  // generation; POOL_PLAY has no engine support yet (see brackets.ts).
  format                 DivisionFormat? @default(BOTH)
  colorTag               String?
  waitlistEnabled        Boolean   @default(false)
  ghostTeamsCount        Int       @default(0)
  leagueGamesCount       Int? // for eventType=LEAGUE
  maxRD                  Int? // generic numeric setting
  genderFilter           String?
  specialPriceCents      Int?
  specialPriceCutoffDate DateTime?
  // Only when this division plays somewhere other than the event's main
  // address -- used for distance calculations.
  addressOverride        String?
  postalCodeOverride     String?
  sortOrder              Int       @default(0)

  // Per-division public visibility toggles.
  showRegistration       Boolean @default(true)
  showTeamsAttending     Boolean @default(true)
  showWaitlist           Boolean @default(true)
  showPoolStandings      Boolean @default(true)
  showDivisionStandings  Boolean @default(true)
  showOverallStandings   Boolean @default(true)
  showSchedule           Boolean @default(true)
  showResults            Boolean @default(true)
}

model Pool {
  id         String   @id @default(cuid())
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id])
  label      String // "Pool A"

  teams Registration[] @relation("PoolAssignment")
  games Game[]
}

model Registration {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  divisionId   String
  division     Division   @relation(fields: [divisionId], references: [id])
  poolId       String?
  pool         Pool?      @relation("PoolAssignment", fields: [poolId], references: [id])

  teamName   String
  coachName  String
  coachEmail String
  coachPhone String

  status          RegistrationStatus @default(PENDING)
  stripeSessionId String?
  paidAt          DateTime?
  // Set when an admin puts this registration on a division's waitlist
  // (status=WAITLISTED); orders the invite queue oldest-first.
  waitlistedAt    DateTime?

  seed        Int? // seed going into the bracket after pool play
  poolWins    Int  @default(0)
  poolLosses  Int  @default(0)
  runsFor     Int  @default(0)
  runsAgainst Int  @default(0)

  bracketWins    Int     @default(0)
  bracketLosses  Int     @default(0)
  finalPlacement String? // e.g. "Champion", "Runner-up", "Lost in Semifinals"
  isVipComp      Boolean @default(false) // paid via VIP access code, not a real card charge

  // Roster approval -- a coach submits the roster once it's final for this
  // event, an admin reviews and approves/rejects it. Separate from just
  // adding/removing players, which stays open the whole time.
  rosterApprovalStatus RosterApprovalStatus @default(NOT_SUBMITTED)
  rosterSubmittedAt    DateTime?
  rosterReviewedAt     DateTime?
  rosterReviewNote     String?

  // Discount code applied at checkout, if any. Kept even after use so the
  // amount is visible on the registration later.
  discountCodeId      String?
  discountCode        DiscountCode? @relation(fields: [discountCodeId], references: [id])
  discountAmountCents Int           @default(0)

  // Sales tax actually charged, from Tournament.salesTaxOverridePercent at
  // the time of checkout -- kept on the registration (like discountAmountCents
  // above) so refund math (chargedCentsFor in src/lib/refunds.ts) knows the
  // true total charged, not just the entry fee.
  salesTaxCents Int @default(0)
  // Processing fee actually charged, from computeProcessingFeeCents() at
  // checkout time (src/lib/pricing.ts) -- same reasoning/pattern as
  // salesTaxCents above: a second charged component refund math needs to
  // reconstruct the true total from stored fields.
  processingFeeCents Int @default(0)

  // Set when this registration was one of several paid together in a
  // single cart checkout (see /api/checkout/cart). Null for a normal
  // one-at-a-time registration.
  orderGroupId String?

  installments PaymentInstallment[]

  // Running total refunded back to the payer across one or more Refund
  // rows. status flips to REFUNDED once this covers everything that was
  // actually charged; a smaller value means a partial refund was issued
  // and the registration still stands.
  refundedAmountCents Int       @default(0)
  fullyRefundedAt     DateTime?
  refunds             Refund[]

  createdAt DateTime @default(now())

  homeGames     Game[]              @relation("HomeTeam")
  awayGames     Game[]              @relation("AwayTeam")
  rosterPlayers RosterPlayer[]
  guestInvites  GuestPlayerInvite[]

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])
}

// A registration paid via a payment plan gets split into these instead of
// one lump-sum Stripe charge. The first is charged immediately at
// checkout; later ones are attempted automatically on their due date by
// a scheduled job (see /api/cron/charge-installments), using the card
// saved to the coach's Stripe Customer at checkout time.
model PaymentInstallment {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  dueDate               DateTime
  amountCents           Int
  status                InstallmentStatus @default(PENDING)
  paidAt                DateTime?
  attemptCount          Int               @default(0)
  lastError             String?
  stripePaymentIntentId String?

  createdAt DateTime @default(now())
}

// One refund issued against a registration by an admin. A registration
// can have several (repeated partial refunds); the sum of amountCents is
// mirrored onto Registration.refundedAmountCents. For a payment-plan
// registration a single "full refund" Refund row covers every underlying
// installment charge, so stripeRefundIds holds more than one id.
model Refund {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  // Returned to the payer.
  amountCents              Int
  // How that amount was funded: pulled back from the tournament owner's
  // connected account, vs. absorbed by the platform (owner already paid
  // out with no balance left to claw back), vs. the platform fee handed
  // back. full refund => platformFeeRefundedCents = the $15; partial
  // refund => 0 (the fee is non-refundable on partials).
  transferReversedCents    Int @default(0)
  platformAbsorbedCents    Int @default(0)
  platformFeeRefundedCents Int @default(0)

  isFull          Boolean  @default(false)
  reason          String?
  stripeRefundIds String[] // Stripe refund ids created for this action
  note            String? // free-text failures / partial-completion detail

  // The admin who issued it. Null when reconciled from a refund made
  // directly in the Stripe dashboard (no app user).
  createdByUserId String?
  createdBy       User?   @relation("RefundIssuedBy", fields: [createdByUserId], references: [id])
  source          String  @default("admin") // "admin" | "stripe_dashboard"

  createdAt DateTime @default(now())
}

model RosterPlayer {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String
  jerseyNumber String?
  position     String?
  isGuest      Boolean @default(false) // added via a one-off guest-player invite link

  createdAt DateTime @default(now())
}

// A shareable, single-use-by-default link a coach (or admin) generates so
// someone outside the normal team roster flow can add a guest player to a
// specific tournament registration -- no login required to use the link.
model GuestPlayerInvite {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  token          String       @unique @default(cuid())
  createdAt      DateTime     @default(now())
  expiresAt      DateTime?
  usedAt         DateTime?
}

model Game {
  id         String   @id @default(cuid())
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id])
  poolId     String?
  pool       Pool?    @relation(fields: [poolId], references: [id])

  stage       GameStage
  round       String? // e.g. "Winners R1", "Championship" for bracket stage
  bracketSlot Int? // position in the bracket for advancement logic

  homeTeamId String?
  homeTeam   Registration? @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String?
  awayTeam   Registration? @relation("AwayTeam", fields: [awayTeamId], references: [id])

  // fieldName stays a free-text display string -- the schedule generator
  // keeps it in sync with venue/fieldNumber below ("Riverside Park — Field
  // 2") so existing readers (public schedule table, BracketTree,
  // ScoreEntry, mobile API) need no changes. venueId/fieldNumber are the
  // structured source of truth used for double-booking checks and the
  // admin schedule editor's venue/field picker.
  fieldName   String?
  startTime   DateTime?
  venueId     String?
  venue       Venue?    @relation(fields: [venueId], references: [id])
  fieldNumber Int?
  // True once an admin has manually set/moved this game's venue/field/time
  // (via the schedule editor or the per-game field/time inputs) -- the
  // bulk schedule generator skips (and treats as already-occupied) any
  // locked game unless the admin explicitly opts in to overriding it too.
  scheduleLocked Boolean @default(false)

  homeScore Int?
  awayScore Int?
  status    GameStatus @default(SCHEDULED)

  advancesToGameId      String? // winner of this game feeds into this next game
  loserAdvancesToGameId String? // loser feeds into this losers-bracket game (double elimination only)

  updatedAt DateTime @updatedAt
}

// --- Director / sanctioning-body layer -------------------------------

model Director {
  id                    String           @id @default(cuid())
  name                  String
  email                 String           @unique
  phone                 String?
  region                String // e.g. "Central Arkansas", "NW Arkansas"
  bio                   String?
  photoUrl              String?
  sanctionFeePaid       Boolean          @default(false)
  backgroundCheckStatus ComplianceStatus @default(PENDING)
  active                Boolean          @default(true)
  createdAt             DateTime         @default(now())

  teams Team[]
}

enum ComplianceStatus {
  PENDING
  SUBMITTED
  APPROVED
  EXPIRED
}

enum RosterApprovalStatus {
  NOT_SUBMITTED
  SUBMITTED
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENT
  FLAT
}

enum InstallmentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED // a scheduled installment voided because the registration was refunded
  REFUNDED // a paid installment that was refunded back to the payer
}

// --- User accounts (coaches and parents) -------------------------------

enum UserRole {
  COACH
  PARENT
  ADMIN
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  phone              String?
  role               UserRole @default(COACH)
  // A lead ("head") admin: can create/edit/remove ANY tournament, manage
  // other admin accounts, and reassign tournament ownership. A plain
  // role=ADMIN can only touch tournaments they own.
  isSuperAdmin       Boolean  @default(false)
  // Set when an account is created with a generated temporary password
  // (lead admin creating another admin). Cleared once they change it.
  mustChangePassword Boolean  @default(false)
  stripeCustomerId   String? // lets Stripe Checkout offer their saved card on future registrations

  // --- Stripe Connect (Express) -------------------------------------
  // Each admin gets their own connected account; registration payments
  // for the tournaments they own are routed there as destination charges.
  // The *_enabled / detailsSubmitted flags are a cache of the Stripe
  // account state, refreshed on the account.updated webhook and on
  // demand -- charges are only routed when stripeConnectChargesEnabled.
  stripeConnectAccountId        String?   @unique
  stripeConnectChargesEnabled   Boolean   @default(false)
  stripeConnectPayoutsEnabled   Boolean   @default(false)
  stripeConnectDetailsSubmitted Boolean   @default(false)
  stripeConnectRefreshedAt      DateTime?

  createdAt DateTime @default(now())

  teams    Team[]
  athletes FamilyAthlete[]

  ownedTournaments Tournament[] @relation("TournamentOwner")
  refundsIssued    Refund[]     @relation("RefundIssuedBy")

  teamLinks           TeamParent[]
  mobileRefreshTokens MobileRefreshToken[]
}

model FamilyAthlete {
  id        String   @id @default(cuid())
  parentId  String
  parent    User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  birthYear Int?
  createdAt DateTime @default(now())
}

// --- Persistent team / roster layer -----------------------------------

model Team {
  id           String    @id @default(cuid())
  name         String
  organization String?
  directorId   String?
  director     Director? @relation(fields: [directorId], references: [id])
  ageGroup     String
  homeCity     String?
  homeState    String    @default("AR")
  logoUrl      String?

  coachUserId String?
  coachUser   User?   @relation(fields: [coachUserId], references: [id])

  insuranceStatus    ComplianceStatus @default(PENDING)
  insuranceProvider  String? // e.g. "Chappell Insurance"
  insuranceExpiresAt DateTime?
  insuranceFileUrl   String?
  insuranceFileName  String?

  createdAt DateTime @default(now())

  players       Player[]
  staff         TeamStaff[]
  documents     TeamDocument[]
  registrations Registration[]
  parents       TeamParent[]
}

model TeamStaff {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  name             String
  role             String // e.g. "Head Coach", "Assistant Coach"
  phone            String?
  email            String?
  isHousingContact Boolean @default(false)

  backgroundCheckStatus   ComplianceStatus @default(PENDING)
  backgroundCheckFileUrl  String?
  backgroundCheckFileName String?

  createdAt DateTime @default(now())
}

model TeamDocument {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  label    String
  fileUrl  String
  fileName String

  createdAt DateTime @default(now())
}

// A parent/family account (User.role === PARENT) linked to a Team so they
// can view its schedule, standings, and registration/payment status --
// read-only, team-wide (not scoped to one child, since Player and
// RosterPlayer aren't the same list and neither reliably identifies a
// specific kid). Created by the mobile app's team-join flow, which reuses
// the same join link a coach already shares for the public /teams/[id]/join
// roster form. athleteName is display context only, never an access check.
model TeamParent {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  athleteName String?

  createdAt DateTime @default(now())

  @@unique([teamId, userId])
}

// Opaque refresh tokens issued by the mobile auth endpoints (see
// src/lib/mobileAuth.ts). Only a SHA-256 hash of the token is stored, so a
// leaked database row can't be replayed as a real refresh token. Rotated
// on every use; replacedByTokenHash + revokedAt let a reused (already-
// rotated) token be detected and the whole chain revoked.
model MobileRefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?

  createdAt DateTime @default(now())

  @@index([userId])
}

model Player {
  id           String  @id @default(cuid())
  teamId       String
  team         Team    @relation(fields: [teamId], references: [id])
  firstName    String
  lastName     String
  jerseyNumber String?
  position     String?
  birthYear    Int?

  backgroundCheckStatus   ComplianceStatus @default(PENDING)
  backgroundCheckFileUrl  String?
  backgroundCheckFileName String?

  createdAt DateTime @default(now())
}

// --- Pricing -------------------------------------------------------------

model DiscountCode {
  id        String       @id @default(cuid())
  code      String       @unique // entered by the customer, case-insensitive match handled in code
  type      DiscountType
  value     Int // PERCENT: whole-number percent (10 = 10%). FLAT: cents off.
  maxUses   Int? // null = unlimited
  usedCount Int          @default(0)
  active    Boolean      @default(true)
  expiresAt DateTime?
  createdAt DateTime     @default(now())

  registrations Registration[]
}

// --- Shared documents (rulebooks, forms) uploaded by BASE staff, visible
// to every team/director -- distinct from TeamDocument, which is a single
// team's own uploaded paperwork. ------------------------------------------

model SiteDocument {
  id        String   @id @default(cuid())
  label     String
  category  String   @default("General") // e.g. "Rules", "Forms", "General"
  fileUrl   String
  fileName  String
  createdAt DateTime @default(now())
}

// --- Content / marketing layer -----------------------------------------

model Post {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String?
  body          String
  coverImageUrl String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
}

model AgeChartEntry {
  id             String @id @default(cuid())
  division       String // e.g. "10U"
  birthYearStart Int
  birthYearEnd   Int
  sport          Sport
  sortOrder      Int    @default(0)
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}
